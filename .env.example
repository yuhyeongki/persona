# Supabase (서버 전용 값입니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
# 사용할 모델 이름 (생략하면 gemini-3.8-flash). 모델이 바뀌면 여기만 고치면 됩니다.
GEMINI_MODEL=gemini-3.8-flash
# 기본 모델이 혼잡하거나 느릴 때 자동으로 대신 쓰는 모델 (빈 값이면 끔)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 교사 페이지 비밀번호 (길고 추측하기 어려운 값으로)
TEACHER_PASSWORD=
